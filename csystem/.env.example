# ตัวอย่างเท่านั้น — อย่าใส่รหัสจริงในไฟล์นี้ (จะขึ้น Git ได้)
#
# === วิธีใช้ที่แนะนำ ===
#
# 1) เครื่องคุณ (ปลอดภัย + ง่าย)
#    copy .env.example .env
#    แก้ .env ให้มี DB_PASS จริง
#    ดับเบิลคลิก run-docker.cmd
#    หรือ: docker compose up --build
#    เปิด http://localhost:3001
#
# 2) Coolify / Kube (ปลอดภัย)
#    - ตัวแปรทั่วไป: Key/Value Pair
#    - รหัสผ่าน (DB_PASS, APP_SESSION_SECRET, ADMIN_PASSWORD): เลือกประเภท Secret
#    - อย่า commit ไฟล์ .env ขึ้น Git
#
# --- Database ---
DB_HOST=tvsdb2.thanvasupos.com
DB_PORT=28914
DB_NAME=BD_CSystem
DB_USER=uinet
DB_PASS=
DB_ENCRYPT=yes

# --- App ---
HOST_PORT=3001
PORT=3000
HOST=0.0.0.0
SERVE_FRONTEND=1
NODE_ENV=production
DOCKER=1
COOKIE_SECURE=0
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# โฟลเดอร์เก็บไฟล์รูปใน container (ต้อง mount Persistent Volume มาที่ path นี้)
UPLOAD_ROOT=/app/backend/uploads

# --- Auth ---
APP_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=
