# ใช้กับ Coolify / Docker — อย่า commit ค่ารหัสจริง
# ใน Coolify: ใส่ Environment Variables ตามคีย์ด้านล่าง

# --- Database (SQL Server ภายนอก) ---
DB_HOST=tvsdb2.thanvasupos.com
DB_PORT=28914
DB_NAME=BD_CSystem
DB_USER=uinet
DB_PASS=
DB_ENCRYPT=yes
# ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- App ---
# Coolify จะ map พอร์ตสาธารณะเข้า PORT (ค่าเริ่มต้นใน image = 3000)
PORT=3000
APP_PORT=3220
FRONTEND_PORT=3000
API_ORIGIN=http://127.0.0.1:3220
NODE_ENV=production
DOCKER=1
COOKIE_SECURE=1

# --- Auth ---
APP_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=
